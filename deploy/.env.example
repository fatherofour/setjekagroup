# Copy to <repo-root>/.env before running `docker compose -f docker-compose.prod.yml up -d`.
# Every value with no default in docker-compose.prod.yml is required — the
# container refuses to start without it (see the `:?` markers there).

POSTGRES_USER=setjeka_erp
POSTGRES_PASSWORD=
POSTGRES_DB=setjeka_erp

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origin nginx serves the app on (used for CORS on the backend) — the
# VPS's own https URL (IP or domain, matching deploy/nginx.conf's cert).
FRONTEND_ORIGIN=https://<vps-ip-or-domain>
