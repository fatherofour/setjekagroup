  @@index([projectId, status])
}

// ---- Drawing markup and the model viewer (2026-10-26) ----------------------
// Register DOC row 51 "Document markup" (saved separately from the original
// file), FIELD row 65 (markups linked to site issues), and BIM rows 55-61.

enum MarkupKind {
  PEN
  RECTANGLE
  CLOUD
  ARROW
  TEXT
  PIN
  // A review stamp, a measured length and a measured area (26 Oct 2026).
  STAMP
  MEASURE
  AREA
}

// One annotation on one page of a drawing revision. Coordinates are
// fractions of the page (0..1), so they hold at any zoom and on any screen.
model DrawingMarkup {
  id           String           @id @default(uuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId   String
  document     ProjectDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId   String
  revision     DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  page         Int              @default(1)
  kind         MarkupKind
  // PEN: { points: [x, y][] }; RECTANGLE / CLOUD: { x, y, w, h };
  // ARROW: { from: [x, y], to: [x, y] }; TEXT / PIN: { x, y }.
  geometry     Json
  color        String           @default("#dc2626")
  text         String?
  authorId     String
  author       User             @relation("MarkupAuthor", fields: [authorId], references: [id])
  issueId      String?
  issue        ProjectIssue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?            @relation("MarkupResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([revisionId, page])
  @@index([projectId])
}

// A model object (by its IFC GlobalId) linked to a project record: an issue
// raised against it, or an RFI, document, photo, inspection or submittal it
// relates to (register BIM rows 59 and 61).
model ModelObjectLink {
  id          String          @id @default(uuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId  String
  document    ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  globalId    String
  expressId   Int?
  ifcType     String?
  name        String?
  entityType  String
  entityId    String
  // The camera when the link was made: { position: [x,y,z], target: [x,y,z] }.
  viewpoint   Json?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@unique([documentId, globalId, entityType, entityId])
  @@index([projectId, entityType, entityId])
}

// ---- Documents, drawings, BIM and costs from OpenConstructionERP (2026-10-26)
// The user chose these from the donor app for the architect: file versions,
// transmittals, full-text search, tags, an admin recycle bin, the BIM hub,
// federation and coordination, smart views, BIM requirements, the rough cost
// estimate, plus clash detection, BCF, drawing index checks, stamps and scale,
// a DWG viewer, punch items on drawings and distribution lists.

model DocumentTag {
  id        String            @id @default(uuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String            @default("#64748b")
  links     DocumentTagLink[]
  createdAt DateTime          @default(now())

  @@unique([projectId, name])
}

model DocumentTagLink {
  documentId String
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        DocumentTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

// The text of one page, for full-text search (searched with Postgres
// to_tsvector at query time).
model DocumentPageText {
  id         String           @id @default(uuid())
  revisionId String
  revision   DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  page       Int
  text       String
  // TEXT: from the PDF's own text; OCR: read off a scan.
  source     String

  @@unique([revisionId, page])
}

// A saved set of recipients for issuing drawings and documents.
model DistributionList {
  id          String                   @id @default(uuid())
  projectId   String
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  members     DistributionListMember[]
  createdById String
  createdBy   User                     @relation(fields: [createdById], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([projectId, name])
}

model DistributionListMember {
  listId          String
  list            DistributionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  projectMemberId String
  projectMember   ProjectMember    @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)

  @@id([listId, projectMemberId])
}

// A drawing page's scale, set by measuring a known length on it. x1..y2 are
// page fractions (as markups); realLength is in metres.
model DrawingCalibration {
  id          String           @id @default(uuid())
  revisionId  String
  revision    DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  page        Int
  x1          Float
  y1          Float
  x2          Float
  y2          Float
  realLength  Float
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@unique([revisionId, page])
}

enum PunchStatus {
  OPEN
  READY_FOR_INSPECTION
  CLOSED
}

// A snag pinned to a drawing (Architect 5.13, 6.1): the contractor puts it
// right and says so; the architect inspects and closes it or sends it back.
model PunchItem {
  id           String            @id @default(uuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence     Int
  number       String
  title        String
  description  String?
  category     String?
  location     String?
  priority     SchedulePriority  @default(MEDIUM)
  status       PunchStatus       @default(OPEN)
  documentId   String?
  document     ProjectDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  revisionId   String?
  revision     DocumentRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  page         Int?
  x            Float?
  y            Float?
  assigneeId   String?
  assignee     ProjectMember?    @relation("PunchAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  raisedById   String
  raisedBy     User              @relation("PunchRaiser", fields: [raisedById], references: [id])
  readyAt      DateTime?
  readyNote    String?
  closedAt     DateTime?
  closedById   String?
  closedBy     User?             @relation("PunchCloser", fields: [closedById], references: [id], onDelete: SetNull)
  rejectedNote String?
  photos       SitePhoto[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([projectId, sequence])
  @@index([projectId, status])
  @@index([revisionId])
}

// ---- BIM hub -----------------------------------------------------------------

// Server-side reading of one IFC model revision into elements.
model BimProcessing {
  id           String           @id @default(uuid())
  revisionId   String           @unique
  revision     DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  status       String
  elementCount Int              @default(0)
  storeys      String[]         @default([])
  schema       String?
  error        String?
  startedAt    DateTime         @default(now())
  finishedAt   DateTime?
}

// One model element. Coordinates are web-ifc's (Y up, metres), as the
// browser viewer draws them; BCF converts to IFC's Z up.
model BimElement {
  id         String           @id @default(uuid())
  projectId  String
  documentId String
  document   ProjectDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId String
  revision   DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  expressId  Int
  globalId   String
  ifcType    String
  name       String?
  typeName   String?
  storey     String?
  material   String?
  // { "Pset_WallCommon.FireRating": "60", ... }
  properties Json             @default("{}")
  // { "Qto_WallBaseQuantities.NetSideArea": 12.3, ... }
  quantities Json             @default("{}")
  minX       Float?
  minY       Float?
  minZ       Float?
  maxX       Float?
  maxY       Float?
  maxZ       Float?
  // Changes between revisions are found by comparing these.
  propsHash  String

  @@unique([revisionId, globalId])
  @@index([revisionId, ifcType])
  @@index([projectId])
}

// A saved set of models opened together.
model BimFederation {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  documentIds String[]
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
}

enum ClashStatus {
  NEW
  ACTIVE
  RESOLVED
  APPROVED
}

// Two element sets checked against each other, e.g. architecture against
// structure. Selections: { documentIds?, ifcTypes?, storeys?, conditions? }.
model ClashTest {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  selectionA  Json
  selectionB  Json
  // Overlap below this many metres is ignored.
  tolerance   Float     @default(0.01)
  lastRunAt   DateTime?
  lastRunMs   Int?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  clashes     Clash[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Clash {
  id          String      @id @default(uuid())
  testId      String
  test        ClashTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  projectId   String
  // The pair, sorted, so a re-run finds the same clash again.
  key         String
  aDocumentId String
  aGlobalId   String
  aName       String?
  aType       String
  bDocumentId String
  bGlobalId   String
  bName       String?
  bType       String
  // Centre of the overlap, and its depth in metres.
  centre      Json
  overlap     Float
  status      ClashStatus @default(NEW)
  issueId     String?
  note        String?
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  resolvedAt  DateTime?

  @@unique([testId, key])
  @@index([projectId, status])
}

// A rule-based view: re-evaluated each time, so new elements that match
// are coloured, hidden or isolated too.
// rules: [{ name, conditions: [{ field, op, value }], action, color }]
model SmartView {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  rules       Json
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
}

// Information requirements, imported from IDS, Excel/CSV or written here.
// requirements: [{ id, description, ifcTypes, property: { set, name },
//   rule: EXISTS | EQUALS | IN | PATTERN | RANGE, value }]
model BimRequirementSet {
  id           String                @id @default(uuid())
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  source       String
  fileName     String?
  requirements Json
  createdById  String
  createdBy    User                  @relation(fields: [createdById], references: [id])
  checks       BimRequirementCheck[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model BimRequirementCheck {
  id         String            @id @default(uuid())
  setId      String
  set        BimRequirementSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  revisionId String
  revision   DocumentRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  // [{ requirementId, applicable, passed, failed, failing: [{ globalId, name, value }] }]
  results    Json
  score      Float
  ranAt      DateTime          @default(now())

  @@index([setId, ranAt])
}

// ---- Rough cost estimate (ROM) ----------------------------------------------

// Setjeka's own rates per m2 by building type and quality, kept current by
// its QS. Seeded with indicative figures to be replaced.
model RomRate {
  id           String   @id @default(uuid())
  buildingType String
  label        String
  quality      String
  ratePerM2    Float
  currency     Currency @default(ZAR)
  updatedById  String?
  updatedBy    User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt

  @@unique([buildingType, quality])
}

model RomRegionFactor {
  id        String   @id @default(uuid())
  region    String   @unique
  factor    Float
  updatedAt DateTime @updatedAt
}

model RomEstimate {
  id             String       @id @default(uuid())
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  name           String
  buildingType   String
  quality        String
  region         String
  gfa            Float
  baseRate       Float
  regionFactor   Float
  escalationPct  Float        @default(0)
  contingencyPct Float        @default(10)
  total          Float
  currency       Currency     @default(ZAR)
  // [{ element, pct, amount }]
  breakdown      Json
  notes          String?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
}

// ---- The quantity surveyor (PROCSA QS, Stages 2 to 6; 2026-10-28) -------
// The user's direction: the QS does their own work in the platform - bills
// of quantities, estimates, valuations, claims and final accounts - and
// Setjeka's Project Manager issues the payment certificates.

// From the preliminary estimate (QS 2.5) to the priced contract bill.
enum CostPlanKind {
  PRELIMINARY
  ELEMENTAL
  DETAILED
  PRE_TENDER
  TENDER_BOQ
  CONTRACT_BOQ
}

enum CostPlanStatus {
  DRAFT
  ISSUED
  ACCEPTED
}

enum CostPlanItemType {
  MEASURED
  PROVISIONAL_SUM
  PRIME_COST_SUM
  DAYWORK
}

// A bill of quantities or cost plan (register COM "BOQ management": import,
// edit, version, approve). Issuing it freezes a numbered revision; editing
// an issued plan takes it back to draft. Setjeka accepts it.
model CostPlan {
  id             String             @id @default(uuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number         String
  title          String
  kind           CostPlanKind
  status         CostPlanStatus     @default(DRAFT)
  revision       Int                @default(0)
  currency       Currency
  grossFloorArea Float?
  // Added in QS order on the items' total: preliminaries, contingency,
  // escalation, then VAT.
  prelimsPct     Float              @default(0)
  contingencyPct Float              @default(0)
  escalationPct  Float              @default(0)
  vatPct         Float              @default(15)
  notes          String?
  sourceFileName String?
  preparedById   String
  preparedBy     User               @relation("CostPlanPreparedBy", fields: [preparedById], references: [id])
  issuedAt       DateTime?
  acceptedById   String?
  acceptedBy     User?              @relation("CostPlanAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  items          CostPlanItem[]
  revisions      CostPlanRevision[]
  rfqs           Rfq[]
  contracts      ProjectContract[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Numbered per project, so every project starts at BQ-001.
  @@unique([projectId, number])
  @@index([projectId])
}

model CostPlanItem {
  id             String           @id @default(uuid())
  costPlanId     String
  costPlan       CostPlan         @relation(fields: [costPlanId], references: [id], onDelete: Cascade)
  sortOrder      Int              @default(0)
  // The bill or element it sits under, e.g. "Bill 3 - Concrete".
  section        String?
  ref            String?
  description    String
  unit           String?
  quantity       Float?
  rate           Float?
  // Quantity x rate, or the sum itself for a lump sum.
  amount         Float            @default(0)
  type           CostPlanItemType @default(MEASURED)
  costCodeId     String?
  costCode       CostCode?        @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  notes          String?
  rfqItems       RfqItem[]
  valuationLines ValuationLine[]
  measurements   SiteMeasurement[]

  @@index([costPlanId])
}

model CostPlanRevision {
  id         String   @id @default(uuid())
  costPlanId String
  costPlan   CostPlan @relation(fields: [costPlanId], references: [id], onDelete: Cascade)
  revision   Int
  total      Float
  itemCount  Int
  // The items as issued.
  snapshot   Json
  reason     String?
  issuedById String
  issuedBy   User     @relation(fields: [issuedById], references: [id])
  issuedAt   DateTime @default(now())

  @@unique([costPlanId, revision])
}

enum FinalAccountStatus {
  NOT_STARTED
  IN_PREPARATION
  SUBMITTED
  AGREED
}

// A contract with a contractor (QS 4.7), the basis for its valuations,
// retention and final account.
model ProjectContract {
  id                  String             @id @default(uuid())
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId        String
  contractor          Contractor         @relation(fields: [contractorId], references: [id])
  title               String
  contractForm        ContractForm?
  contractSum         Float
  currency            Currency
  // The priced contract bill, and the tender it came from.
  costPlanId          String?
  costPlan            CostPlan?          @relation(fields: [costPlanId], references: [id], onDelete: SetNull)
  rfqId               String?
  rfq                 Rfq?               @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  // The consultant who reviews its valuations and administers it: the
  // architect as principal agent, or the engineer for engineering works
  // (PROCSA Civil Engineer 5.8, 5.13; 2026-10-29).
  reviewerRole        ProjectMemberRole  @default(ARCHITECT)
  retentionPct        Float              @default(10)
  // Retention stops growing at this share of the contract sum.
  retentionLimitPct   Float?             @default(5)
  vatPct              Float              @default(15)
  // Days to certify a valuation and to pay a certificate. Empty means the
  // form of contract's usual periods (common/contract-forms.ts).
  certifyWithinDays   Int?
  payWithinDays       Int?
  startDate           DateTime?
  completionDate      DateTime?
  finalAccountStatus  FinalAccountStatus @default(NOT_STARTED)
  // The final-accounts register entry kept in step with it.
  finalAccountEntryId String?
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  valuations          Valuation[]
  variations          Variation[]
  // Paid on quantities measured on site (remeasurement), not % complete.
  measured            Boolean            @default(false)
  siteMeasurements    SiteMeasurement[]
  dayworkSheets       DayworkSheet[]
  // Penalties for late completion, per calendar day (contract data), and the
  // contractor's claims for more time.
  penaltyPerDay       Float?
  timeClaims          TimeClaim[]
  // Completion and the defects liability period (2026-11-03): practical
  // completion, works completion once the practical completion list is
  // cleared, the defects period (the form's usual length unless the contract
  // says otherwise), and final completion once its defects are put right.
  practicalCompletionAt DateTime?
  worksCompletionAt     DateTime?
  defectsPeriodDays     Int?
  defectsPeriodEndsAt   DateTime?
  finalCompletionAt     DateTime?
  defects               ContractDefect[]
  handoverItems         HandoverItem[]
  // Contract price adjustment (CPAP): the month the tender was priced at,
  // the share that isn't adjusted, how many months the indices lag the
  // valuation, and each index's weighting. No weightings, no adjustment.
  escalationBaseMonth DateTime?
  escalationFixedPct  Float              @default(15)
  escalationLagMonths Int                @default(0)
  escalationWeights   ContractEscalationWeight[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([projectId])
}

/// A published cost index (Stats SA's CPAP series and the like): kept once,
/// for every project's contracts.
model PriceIndex {
  id        String                     @id @default(uuid())
  code      String                     @unique
  name      String
  source    String?
  values    PriceIndexValue[]
  weights   ContractEscalationWeight[]
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
}

/// An index's value for a month (the first of the month).
model PriceIndexValue {
  id      String     @id @default(uuid())
  indexId String
  index   PriceIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  month   DateTime
  value   Float

  @@unique([indexId, month])
}

/// A contract's weighting on one index; a contract's weightings add to 1.
model ContractEscalationWeight {
  id         String          @id @default(uuid())
  contractId String
  contract   ProjectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  indexId    String
  index      PriceIndex      @relation(fields: [indexId], references: [id], onDelete: Restrict)
  weight     Float

  @@unique([contractId, indexId])
}

enum ValuationStatus {
  DRAFT
  SUBMITTED
  CERTIFIED
  APPROVED
  REJECTED
  PAID
}

// A payment valuation (QS 5.8, 6.1). The QS prepares it, the architect
// reviews it, Setjeka's PM issues the certificate, the client approves
// payment, and Setjeka records it paid.
model Valuation {
  id                  String           @id @default(uuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId          String
  contract            ProjectContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  number              Int
  isFinal             Boolean          @default(false)
  valuationDate       DateTime
  status              ValuationStatus  @default(DRAFT)
  materialsOnSite     Float            @default(0)
  // 50 once half the retention is released at practical completion, 100 at final.
  retentionReleasePct Float            @default(0)
  // Worked out from the lines; fixed once submitted.
  workDone            Float            @default(0)
  variationsDone      Float            @default(0)
  grossValuation      Float            @default(0)
  retention           Float            @default(0)
  cumulativeNet       Float            @default(0)
  previouslyCertified Float            @default(0)
  netDue              Float            @default(0)
  vat                 Float            @default(0)
  amountDue           Float            @default(0)
  // Contract price adjustment to date (cumulative), and how it was worked.
  escalationToDate    Float            @default(0)
  escalationNote      String?
  notes               String?
  preparedById        String
  preparedBy          User             @relation("ValuationPreparedBy", fields: [preparedById], references: [id])
  submittedAt         DateTime?
  returnedReason      String?
  certificateNumber   String?
  certifiedById       String?
  certifiedBy         User?            @relation("ValuationCertifiedBy", fields: [certifiedById], references: [id], onDelete: SetNull)
  certifiedAt         DateTime?
  // The payment-certificates register entry the architect reviews.
  registerEntryId     String?
  // When the PM is to certify it and Setjeka to pay it, from the contract's
  // periods (Meeting 002 decision 2.6: the form sets the time periods).
  certifyDueAt        DateTime?
  payDueAt            DateTime?
  responseDueAt       DateTime?
  decidedById         String?
  decidedBy           User?            @relation("ValuationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt           DateTime?
  decisionOutcome     ApprovalOutcome?
  decisionComment     String?
  paidAt              DateTime?
  paymentReference    String?
  lines               ValuationLine[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([contractId, number])
  @@index([projectId])
}

model ValuationLine {
  id              String        @id @default(uuid())
  valuationId     String
  valuation       Valuation     @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)
  costPlanItemId  String?
  costPlanItem    CostPlanItem? @relation(fields: [costPlanItemId], references: [id], onDelete: SetNull)
  variationId     String?
  variation       Variation?    @relation(fields: [variationId], references: [id], onDelete: SetNull)
  description     String
  contractAmount  Float
  percentComplete Float         @default(0)
  valueToDate     Float         @default(0)
  // On a measured contract: the quantity measured to date, at the bill rate.
  quantityToDate  Float?
  rate            Float?
  dayworkSheetId  String?
  dayworkSheet    DayworkSheet? @relation(fields: [dayworkSheetId], references: [id], onDelete: SetNull)

  @@index([valuationId])
}

// ---- Non-conformance reports (register QHSE "NCR", Required: Yes) ---------
// The user, 29 Oct 2026, bringing over what the civil engineer needs from
// OpenConstructionERP (its ncr module, rebuilt). A consultant or Setjeka
// raises it to the contractor, often from a failed inspection; the
// contractor gives the root cause and corrective action; the raiser agrees
// it; the contractor puts it right; the raiser verifies and closes it.
enum NcrKind {
  MATERIAL
  WORKMANSHIP
  DESIGN
  DOCUMENTATION
  OTHER
}

enum NcrSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcrStatus {
  OPEN
  RESPONDED
  ACTION_AGREED
  READY_FOR_VERIFICATION
  CLOSED
  VOID
}

model NonConformance {
  id                String          @id @default(uuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence          Int
  number            String
  title             String
  description       String
  kind              NcrKind         @default(WORKMANSHIP)
  severity          NcrSeverity     @default(MINOR)
  location          String?
  status            NcrStatus       @default(OPEN)
  raisedById        String
  raisedBy          User            @relation("NcrRaisedBy", fields: [raisedById], references: [id])
  // The contractor's person it is issued to.
  assigneeId        String?
  assignee          ProjectMember?  @relation("NcrAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  inspectionId      String?
  inspection        SiteInspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  testResultId      String?
  testResult        TestResult?     @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  hiddenWorkId      String?
  hiddenWork        HiddenWork?     @relation(fields: [hiddenWorkId], references: [id], onDelete: SetNull)
  dueDate           DateTime?
  rootCauseCategory String?
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  costImpact        Float?
  timeImpactDays    Int?
  respondedAt       DateTime?
  agreedAt          DateTime?
  readyAt           DateTime?
  closedAt          DateTime?
  closedById        String?
  closedBy          User?           @relation("NcrClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  voidReason        String?
  events            NcrEvent[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Numbered per project, so every project starts at NCR-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

model NcrEvent {
  id         String         @id @default(uuid())
  ncrId      String
  ncr        NonConformance @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  fromStatus NcrStatus?
  toStatus   NcrStatus
  actorId    String
  actor      User           @relation("NcrEventActor", fields: [actorId], references: [id])
  comment    String?
  createdAt  DateTime       @default(now())

  @@index([ncrId])
}

// ---- Test results and hold / witness points (2026-11-03) ------------------
// From the list kept until all roles were built (the donor app's
// construction_control). Each project keeps its acceptance criteria; a test
// result is checked against its criterion and passes or fails, the reviewing
// engineer or QA/QC signs it off, and a fail can raise an NCR. Hold and
// witness points are the inspection and test plan's stops: the contractor
// gives notice, and a hold point must be released before its programme
// activity can progress.
enum TestRule {
  MIN
  MAX
  RANGE
  PASS_FAIL
}

model TestCriterion {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  name        String
  standardRef String?
  unit        String?
  rule        TestRule
  minValue    Float?
  maxValue    Float?
  // How often to test, e.g. "1 set of 3 cubes per 50 m3 or per pour".
  frequency   String?
  active      Boolean      @default(true)
  results     TestResult[]
  holdPoints  HoldPoint[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, code])
}

enum TestOutcome {
  PASS
  FAIL
}

enum TestResultStatus {
  RECORDED
  REVIEWED
}

model TestResult {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  criterionId        String
  criterion          TestCriterion     @relation(fields: [criterionId], references: [id])
  // What was tested, e.g. "Ground floor slab, bay C".
  title              String
  location           String?
  contractorId       String?
  contractor         Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  scheduleActivityId String?
  scheduleActivity   ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  holdPointId        String?
  holdPoint          HoldPoint?        @relation(fields: [holdPointId], references: [id], onDelete: SetNull)
  // A retest of an earlier result (cores after failed cubes, say).
  retestOfId         String?
  retestOf           TestResult?       @relation("TestRetest", fields: [retestOfId], references: [id], onDelete: SetNull)
  retests            TestResult[]      @relation("TestRetest")
  sampleRef          String?
  laboratory         String?
  sampledAt          DateTime?
  testedAt           DateTime
  value              Float?
  outcome            TestOutcome
  remarks            String?
  status             TestResultStatus  @default(RECORDED)
  recordedById       String
  recordedBy         User              @relation("TestRecordedBy", fields: [recordedById], references: [id])
  reviewedById       String?
  reviewedBy         User?             @relation("TestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewComment      String?
  ncrs               NonConformance[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Numbered per project: TR-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

enum HoldPointKind {
  HOLD
  WITNESS
}

enum HoldPointStatus {
  PLANNED
  NOTIFIED
  RELEASED
  // A witness point whose witness did not come: the contractor went ahead.
  PROCEEDED
  CANCELLED
}

model HoldPoint {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  kind               HoldPointKind
  title              String
  description        String?
  location           String?
  scheduleActivityId String?
  scheduleActivity   ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  criterionId        String?
  criterion          TestCriterion?    @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  // The contractor whose work stops here, and who releases or witnesses it.
  contractorId       String?
  contractor         Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  releaserId         String?
  releaser           ProjectMember?    @relation("HoldPointReleaser", fields: [releaserId], references: [id], onDelete: SetNull)
  noticeHours        Int               @default(24)
  status             HoldPointStatus   @default(PLANNED)
  readyAt            DateTime?
  notifiedAt         DateTime?
  notifiedById       String?
  notifiedBy         User?             @relation("HoldPointNotifiedBy", fields: [notifiedById], references: [id], onDelete: SetNull)
  releasedAt         DateTime?
  releasedById       String?
  releasedBy         User?             @relation("HoldPointReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  releaseComment     String?
  cancelReason       String?
  // [{ status, at, by, comment }], oldest first.
  history            Json              @default("[]")
  createdById        String
  createdBy          User              @relation("HoldPointCreatedBy", fields: [createdById], references: [id])
  tests              TestResult[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Numbered per project, one sequence for both: HP-001, WP-002.
  @@unique([projectId, sequence])
  @@index([projectId, status])
  @@index([scheduleActivityId])
}

// ---- Interfaces register and hidden-works sign-off (2026-11-03) ------------
// From the list kept until all roles were built (the donor app's
// interface_management and site_supervision hidden-works register). An
// interface is a hand-over between two parties - a slab penetration the
// mechanical engineer needs from the structural engineer, say. The owner
// proposes the agreed detail, the accepter agrees it, and it is closed once
// built. Hidden works are signed off, with photos, before they are covered.
enum InterfaceType {
  PHYSICAL
  FUNCTIONAL
  SPATIAL
  INFORMATION
  SCHEDULE
  CONTRACTUAL
}

enum InterfaceStatus {
  OPEN
  PROPOSED
  AGREED
  CLOSED
  CANCELLED
}

model ProjectInterface {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  title              String
  description        String?
  type               InterfaceType     @default(PHYSICAL)
  location           String?
  // Who provides it and has to get the detail agreed, and who depends on it.
  ownerId            String
  owner              ProjectMember     @relation("InterfaceOwner", fields: [ownerId], references: [id])
  accepterId         String
  accepter           ProjectMember     @relation("InterfaceAccepter", fields: [accepterId], references: [id])
  needBy             DateTime?
  scheduleActivityId String?
  scheduleActivity   ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  rfiId              String?
  rfi                Rfi?              @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  status             InterfaceStatus   @default(OPEN)
  agreedDetail       String?
  proposedAt         DateTime?
  agreedAt           DateTime?
  agreedById         String?
  agreedBy           User?             @relation("InterfaceAgreedBy", fields: [agreedById], references: [id], onDelete: SetNull)
  closedAt           DateTime?
  rejectReason       String?
  cancelReason       String?
  // [{ status, at, by, name, comment }], oldest first.
  history            Json              @default("[]")
  createdById        String
  createdBy          User              @relation("InterfaceCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Numbered per project: IF-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

enum HiddenWorkStatus {
  REQUESTED
  APPROVED
  REJECTED
  COVERED
  // Found covered before it was signed off.
  COVERED_UNAPPROVED
  CANCELLED
}

model HiddenWork {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  // What is about to be covered, e.g. "Sewer MH3 to MH5, before backfill".
  title              String
  trade              String?
  location           String?
  contractorId       String?
  contractor         Contractor?       @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  scheduleActivityId String?
  scheduleActivity   ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  inspectorId        String?
  inspector          ProjectMember?    @relation("HiddenWorkInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  readyAt            DateTime?
  // The record of what is covered: sizes, depths, positions, falls.
  asBuilt            String?
  status             HiddenWorkStatus  @default(REQUESTED)
  requestedById      String
  requestedBy        User              @relation("HiddenWorkRequestedBy", fields: [requestedById], references: [id])
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?             @relation("HiddenWorkDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionComment    String?
  coveredAt          DateTime?
  history            Json              @default("[]")
  photos             SitePhoto[]
  ncrs               NonConformance[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Numbered per project: HW-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

// ---- Progress recorded on site (2026-11-04) ---------------------------------
// The look-ahead's progress updates, kept as a history: who said how far an
// activity had got, on which day, and why. The activity's % complete moves
// with each entry (through the programme, so hold points still hold).
model ScheduleProgressEntry {
  id              String           @id @default(uuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId      String
  activity        ScheduleActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  percentComplete Int
  previousPercent Int
  note            String?
  recordedById    String
  recordedBy      User             @relation(fields: [recordedById], references: [id])
  createdAt       DateTime         @default(now())

  @@index([activityId, date])
  @@index([projectId, date])
}

// ---- The daily site diary (2026-11-04) --------------------------------------
// The site manager's items, built on the user's go-ahead (2026-11-04) with
// the Field operations scope to confirm with Setjeka later. One diary per
// project per day: who was on site, the plant, the weather, visitors,
// deliveries, delays, instructions and safety. Signed, it is locked: the
// record a delay claim and the safety statistics lean on.
enum DiaryStatus {
  DRAFT
  SIGNED
}

model SiteDiary {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The calendar day on site.
  date         DateTime    @db.Date
  workingHours Float       @default(9)
  weatherNote  String?
  // [{ party, trade, count }]: people on site by firm and trade.
  labour       Json        @default("[]")
  // [{ description, count, state: WORKING | STANDING | BROKEN_DOWN }]
  plant        Json        @default("[]")
  visitors     String?
  deliveries   String?
  // Anything that held the work up: weather, information, access, the
  // client - what a delay claim later points to.
  delays       String?
  instructions String?
  safety       String?
  notes        String?
  status       DiaryStatus @default(DRAFT)
  authorId     String
  author       User        @relation("DiaryAuthor", fields: [authorId], references: [id])
  signedAt     DateTime?
  signedById   String?
  signedBy     User?       @relation("DiarySignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([projectId, date])
}

// ---- Plant and equipment (2026-11-04) ----------------------------------------
// The last of the site manager's items. The plant on site, owned or hired:
// when it came and is due off hire, who operates it, whether it is working,
// standing or broken down, and when its next inspection and certificate
// (load test, certificate of fitness) fall due. A failed inspection takes it
// out of use until it passes one. The diary's plant list starts from it.
enum PlantCategory {
  EARTHMOVING
  LIFTING
  ACCESS
  CONCRETE
  COMPACTION
  TRANSPORT
  POWER
  SMALL_PLANT
  OTHER
}

enum PlantStatus {
  WORKING
  STANDING
  BROKEN_DOWN
  OFF_SITE
}

enum PlantOwnership {
  OWNED
  HIRED
}

model PlantItem {
  id                     String         @id @default(uuid())
  projectId              String
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence               Int
  number                 String
  description            String
  category               PlantCategory
  // Fleet number, registration or serial.
  fleetNumber            String?
  ownership              PlantOwnership @default(HIRED)
  // The hire company, or the owner.
  supplier               String?
  contractorId           String?
  contractor             Contractor?    @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  operator               String?
  operatorCertExpiry     DateTime?      @db.Date
  arrivedOn              DateTime       @db.Date
  offHireDue             DateTime?      @db.Date
  departedOn             DateTime?      @db.Date
  status                 PlantStatus    @default(WORKING)
  // Failed its last inspection: out of use until it passes one.
  outOfUse               Boolean        @default(false)
  inspectionIntervalDays Int?
  lastInspectedOn        DateTime?      @db.Date
  nextInspectionDue      DateTime?      @db.Date
  certificateExpiry      DateTime?      @db.Date
  // [{ kind, at, by, name, note, ... }]: arrival, status changes,
  // inspections and departure.
  history                Json           @default("[]")
  addedById              String
  addedBy                User           @relation("PlantAddedBy", fields: [addedById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Numbered per project: PL-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

// ---- Permits to work (2026-11-04) -------------------------------------------
// From the user's role-by-role review of the donor app (hse_advanced).
// High-risk work - hot work, work at height, excavation, confined spaces,
// electrical isolation, lifting - needs a permit: the contractor (or the
// site team) asks for it with its precautions confirmed, the HSE or site
// manager issues it for a set period, and it is handed back and closed when
// the work is done and the area safe.
enum PermitType {
  HOT_WORK
  WORKING_AT_HEIGHT
  EXCAVATION
  CONFINED_SPACE
  ELECTRICAL_ISOLATION
  LIFTING
  OTHER
}

enum PermitStatus {
  REQUESTED
  ISSUED
  SUSPENDED
  HANDED_BACK
  CLOSED
  REJECTED
  CANCELLED
}

model WorkPermit {
  id            String       @id @default(uuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence      Int
  number        String
  type          PermitType
  title         String
  description   String
  location      String
  contractorId  String?
  contractor    Contractor?  @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  // The people who will do the work, as written.
  workers       String?
  validFrom     DateTime
  validTo       DateTime
  // [{ text, done }]: the precautions for the type, confirmed by whoever asks.
  checklist     Json         @default("[]")
  // Confined spaces: the gas test before entry.
  gasTest       String?
  status        PermitStatus @default(REQUESTED)
  conditions    String?
  requestedById String
  requestedBy   User         @relation("PermitRequestedBy", fields: [requestedById], references: [id])
  issuedById    String?
  issuedBy      User?        @relation("PermitIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt      DateTime?
  handedBackAt  DateTime?
  handBackNote  String?
  closedAt      DateTime?
  reason        String?
  history       Json         @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Numbered per project: PTW-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

// ---- HSE incidents (2026-11-04) ---------------------------------------------
// From the user's role-by-role review of the donor app (safety /
// hse_advanced); incidents only, no near misses (the user, 2026-11-04).
// Anyone on site reports an incident; the HSE manager (or Setjeka)
// investigates it, sets corrective actions with owners, and closes it once
// they are done. Incidents the OHS Act requires to be reported to the
// Department of Employment and Labour (section 24) are flagged and the
// report recorded.
enum IncidentKind {
  INJURY
  PROPERTY_DAMAGE
  ENVIRONMENTAL
  FIRE
  DANGEROUS_OCCURRENCE
  SECURITY
  OTHER
}

enum IncidentSeverity {
  // No injury: damage, a spill, a theft.
  NO_INJURY
  FIRST_AID
  MEDICAL_TREATMENT
  LOST_TIME
  FATALITY
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  ACTIONS_OPEN
  CLOSED
}

model HseIncident {
  id                 String           @id @default(uuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  title              String
  kind               IncidentKind
  severity           IncidentSeverity
  occurredAt         DateTime
  location           String?
  description        String
  immediateAction    String?
  // Who was hurt or involved, as written (no personal records kept here).
  personsInvolved    String?
  contractorId       String?
  contractor         Contractor?      @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  lostDays           Int?
  status             IncidentStatus   @default(REPORTED)
  // OHS Act section 24: reported to the Department of Employment and Labour.
  reportable         Boolean          @default(false)
  reportedToDelAt    DateTime?
  delReference       String?
  rootCause          String?
  investigationNotes String?
  investigatedAt     DateTime?
  reportedById       String
  reportedBy         User             @relation("IncidentReportedBy", fields: [reportedById], references: [id])
  closedAt           DateTime?
  closedById         String?
  closedBy           User?            @relation("IncidentClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  history            Json             @default("[]")
  actions            IncidentAction[]
  photos             SitePhoto[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Numbered per project: INC-001.
  @@unique([projectId, sequence])
  @@index([projectId, status])
}

model IncidentAction {
  id          String         @id @default(uuid())
  incidentId  String
  incident    HseIncident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  description String
  ownerId     String?
  owner       ProjectMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  doneAt      DateTime?
  doneNote    String?
  createdAt   DateTime       @default(now())

  @@index([incidentId])
}

// ---- The handover pack (2026-11-03) ----------------------------------------
// From the user's role-by-role review of the donor app (closeout and
// commissioning). Each contract has a list of what the contractor hands
// over: as-built drawings, O&M manuals, warranties and guarantees,
// statutory certificates, commissioning records and the health and safety
// file. The contractor uploads each, the consultant accepts it or returns
// it, and Setjeka hands the accepted pack to the client. Final completion
// waits on the pack; warranties are reminded before they expire.
enum HandoverKind {
  AS_BUILT
  O_AND_M_MANUAL
  WARRANTY
  GUARANTEE
  STATUTORY_CERTIFICATE
  COMMISSIONING
  HEALTH_AND_SAFETY_FILE
  OTHER
}

enum HandoverStatus {
  OUTSTANDING
  SUBMITTED
  RETURNED
  ACCEPTED
  HANDED_OVER
}

model HandoverItem {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId      String
  contract        ProjectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence        Int
  number          String
  kind            HandoverKind
  title           String
  // The system or element it covers, e.g. "Fire detection", "Lifts".
  system          String?
  dueDate         DateTime?
  status          HandoverStatus  @default(OUTSTANDING)
  // Warranties and guarantees: who gives it, and until when.
  issuer          String?
  expiresAt       DateTime?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?           @relation("HandoverReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewComment   String?
  handedOverAt    DateTime?
  registerEntryId String?
  history         Json            @default("[]")
  files           HandoverFile[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Numbered per project: HO-001.
  @@unique([projectId, sequence])
  @@index([contractId, status])
}

model HandoverFile {
  id             String       @id @default(uuid())
  itemId         String
  item           HandoverItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  filename       String
  storedFilename String
  mimeType       String
  size           Int
  uploadedById   String
  uploadedBy     User         @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([itemId])
}

// ---- Defects liability (2026-11-03) ----------------------------------------
// From the user's role-by-role review of the donor app (defects_liability).
// Defects are listed against a contract at practical completion, in the
// defects liability period, or as latent defects afterwards. The contractor
// puts each right and the consultant verifies it. Works completion waits on
// the practical completion list; final completion on the defects period's
// end and its defects; and the retention is released in step (half at
// practical completion, the rest on the final valuation).
enum DefectList {
  PRACTICAL_COMPLETION
  DEFECTS_LIABILITY
  LATENT
}

enum DefectStatus {
  // Reported by the client, for Setjeka or a consultant to issue.
  REPORTED
  OPEN
  RECTIFIED
  VERIFIED
  DECLINED
}

model ContractDefect {
  id              String          @id @default(uuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId      String
  contract        ProjectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence        Int
  number          String
  list            DefectList
  title           String
  description     String?
  location        String?
  status          DefectStatus    @default(OPEN)
  dueDate         DateTime?
  raisedById      String
  raisedBy        User            @relation("DefectRaisedBy", fields: [raisedById], references: [id])
  rectifiedAt     DateTime?
  rectifiedNote   String?
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      User?           @relation("DefectVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  declineReason   String?
  reopened        Int             @default(0)
  // The Defects register entry kept in step with it.
  registerEntryId String?
  history         Json            @default("[]")
  photos          SitePhoto[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Numbered per project: DEF-001.
  @@unique([projectId, sequence])
  @@index([contractId, status])
}

// ---- Delay notices and extension-of-time claims (2026-11-03) ---------------
// From the user's role-by-role review of the donor app (its variations
// module's notices and EOT claims). The contractor gives notice of a delay
// event within the form of contract's period, then submits the claim; the
// Setjeka PM assesses it and grants days, which move the contract's
// completion date. Granted costs go to the client as a variation, so the
// client alone approves money (Meeting 3).
enum DelayCause {
  VARIATION
  LATE_INFORMATION
  CLIENT_DELAY
  SITE_ACCESS
  WEATHER
  STATUTORY
  FORCE_MAJEURE
  OTHER
}

enum TimeClaimStatus {
  NOTIFIED
  SUBMITTED
  GRANTED
  PARTLY_GRANTED
  REJECTED
  WITHDRAWN
}

enum ClaimResponse {
  ACCEPTED
  DISPUTED
}

model TimeClaim {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId         String
  contract           ProjectContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence           Int
  number             String
  title              String
  cause              DelayCause
  description        String
  eventStartedAt     DateTime
  eventEndedAt       DateTime?
  notifiedAt         DateTime
  notifiedById       String
  notifiedBy         User              @relation("TimeClaimNotifiedBy", fields: [notifiedById], references: [id])
  // Days the notice came after the form's notice period, when it was late.
  lateNoticeDays     Int?
  claimDueAt         DateTime
  scheduleActivityId String?
  scheduleActivity   ScheduleActivity? @relation(fields: [scheduleActivityId], references: [id], onDelete: SetNull)
  variationId        String?
  variation          Variation?        @relation("TimeClaimCause", fields: [variationId], references: [id], onDelete: SetNull)
  rfiId              String?
  rfi                Rfi?              @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  status             TimeClaimStatus   @default(NOTIFIED)
  requestedDays      Int?
  costClaimed        Float?
  particulars        String?
  submittedAt        DateTime?
  assessDueAt        DateTime?
  grantedDays        Int?
  grantedCost        Float?
  assessment         String?
  decidedAt          DateTime?
  decidedById        String?
  decidedBy          User?             @relation("TimeClaimDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  response           ClaimResponse?
  responseNote       String?
  respondedAt        DateTime?
  // The variation raised for the granted costs, for the client to approve.
  costVariationId    String?
  costVariation      Variation?        @relation("TimeClaimCostVariation", fields: [costVariationId], references: [id], onDelete: SetNull)
  // The Contractual claims register entry kept in step with it.
  registerEntryId    String?
  history            Json              @default("[]")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Numbered per project: EOT-001.
  @@unique([projectId, sequence])
  @@index([contractId, status])
}

// ---- Measured contracts: site measurement and dayworks (2026-11-02) -------
// The user's choice from the list kept until all roles were built. Civil
// (GCC) contracts are paid on quantities measured on site; work outside the
// bill is paid on daywork sheets (the donor app's site measurements and
// daywork sheets, rebuilt).
enum MeasurementStatus {
  RECORDED
  AGREED
  DISPUTED
}

model SiteMeasurement {
  id             String            @id @default(uuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId     String
  contract       ProjectContract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  costPlanItemId String
  costPlanItem   CostPlanItem      @relation(fields: [costPlanItemId], references: [id], onDelete: Cascade)
  date           DateTime
  location       String?
  quantity       Float
  notes          String?
  status         MeasurementStatus @default(RECORDED)
  recordedById   String
  recordedBy     User              @relation("MeasurementRecordedBy", fields: [recordedById], references: [id])
  respondedById  String?
  respondedBy    User?             @relation("MeasurementRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt    DateTime?
  disputeReason  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([contractId, costPlanItemId])
}

enum DayworkStatus {
  SUBMITTED
  SIGNED
  REJECTED
}

model DayworkSheet {
  id             String          @id @default(uuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractId     String
  contract       ProjectContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequence       Int
  number         String
  date           DateTime
  description    String
  labour         Float           @default(0)
  plant          Float           @default(0)
  materials      Float           @default(0)
  total          Float           @default(0)
  status         DayworkStatus   @default(SUBMITTED)
  submittedById  String
  submittedBy    User            @relation("DayworkSubmittedBy", fields: [submittedById], references: [id])
  decidedById    String?
  decidedBy      User?           @relation("DayworkDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNote   String?
  valuationLines ValuationLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Numbered per contract, so each contract starts at DW-001.
  @@unique([contractId, sequence])
  @@index([projectId])
}
