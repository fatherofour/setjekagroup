  inspector          ProjectMember?      @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  scheduledFor       DateTime?
  templateId         String?
  template           InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // [{ text, result: PASS | FAIL | NA | null, note }]
